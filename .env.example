# ─── Oracle DB ───────────────────────────────────────────────────────────────
ORACLE_HOST=20.102.78.61
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=VF_AGENT
ORACLE_PASSWORD=your_password_here

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Provider: "gemini" | "openai" | "anthropic" | "ollama"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Optional OpenAI / Anthropic fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Semantic Layer ───────────────────────────────────────────────────────────
SEMANTIC_LAYER_DIR=semantic_layer
OVERRIDES_FILE=semantic_layer/overrides.yaml
CHANGELOG_FILE=semantic_layer/changelog.json

# ─── Cache ────────────────────────────────────────────────────────────────────
LLM_CACHE_DIR=.llm_cache
LLM_CACHE_ENABLED=true

# ─── Eval ─────────────────────────────────────────────────────────────────────
EVAL_OUTPUT_DIR=eval_output
BENCHMARK_FILE=benchmark/questions.json
EVAL_RUNS=3          # times each question is repeated for consistency scoring

# ─── Server ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
